node_modules/
dist/
.env
.env.*
!.env.example
.DS_Store
*.log
.nightorders/

# Protocol files a stray test stub could write into this checkout
NIGHTORDERS-*.json
*.tgz

# design-sync machine state (staged scripts, build output, caches)
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules
design/styles/operations-ledger.css

# Local browser artifacts and review/certification snapshots
output/
.playwright-cli/

# Check evidence (screenshots, journey output) lives in the run's evidence, never the branch
/evidence/

# youiyoux's local state (captures, requests, usage maps, inventories). The list of screens youiyoux photographs
# stays tracked, so each revamp wave is compared on the same routes.
/.youi/*
!/.youi/screens/
/.youi/screens/*
!/.youi/screens/screens.json
# The app screens the Canvas photographs (toolroll.app-screens/v1) are tracked; their captures, mirrored by
# scripts/canvas-capture-ios.sh, stay local.
!/.youi/screens/app.json
/.youi/screens/toolroll/

# A test run's fake outer home (test/temp-root.ts), removed with the run
/.test-outer/

# Native macOS & iOS app SwiftPM / Xcode build artifacts
mac/.build/
mac/build/
ios/**/.build/
ios/build/
ios/DerivedData/
*.xcuserstate

# Wrangler's local state (wrangler dev / deploy)
relay/cloudflare/.wrangler/
