{
  "name": "toolroll",
  "version": "0.9.105",
  "description": "Your agents build. You decide. A control plane for coding agents — Claude Code, Codex, Gemini: approve the exact scope once, get results back Ready with the diff, the passing check and screenshots. Runs on your machine.",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/browser-build.mjs && node scripts/postbuild.mjs",
    "test": "vitest run --exclude '**/*.slow.test.ts'",
    "test:slow": "vitest run .slow.test",
    "test:all": "vitest run",
    "test:attacks": "vitest run --config test/attacks/vitest.config.ts",
    "test:git": "vitest run test/attacks/checkout-git- test/attacks/fence-git-views test/attacks/repository-context-git test/attacks/discover-dirty src/teardown-git.test.ts src/worktree.slow.test.ts",
    "check:quick": "node scripts/quick-check.mjs",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.browser.json && tsc -p tsconfig.tui.json",
    "certify:provider": "npm run build && node scripts/provider-canary.mjs",
    "certify:recovery": "npm run build && node scripts/recovery-canary.mjs",
    "certify:crash": "npm run build && node scripts/crash-canary.mjs",
    "certify:pilot": "npm run build && node scripts/pilot.mjs",
    "prepublishOnly": "npm run typecheck && npm run build",
    "nul-scan": "node scripts/nul-scan.mjs",
    "proof-preflight": "node scripts/proof-preflight.mjs",
    "build:desktop": "node scripts/build-desktop.mjs",
    "certify:restart": "npm run build && node scripts/restart-certification.mjs",
    "certify:launchd": "npm run build && node scripts/launchd-certification.mjs",
    "test:native-containment": "vitest run src/containment-native.test.ts src/containment.test.ts",
    "build:browser": "node scripts/browser-build.mjs",
    "e2e:flows": "npm run build && node scripts/flows-e2e.mjs",
    "e2e:app": "npm run build && node scripts/app-e2e.mjs",
    "e2e:app:parallel": "npm run build && node scripts/e2e-parallel.mjs scripts/app-e2e.mjs",
    "e2e": "npm run build && node scripts/flows-e2e.mjs && node scripts/app-e2e.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ap9000/toolroll.git"
  },
  "keywords": [
    "agents",
    "orchestration",
    "claude-code",
    "codex",
    "git-worktree",
    "ai-agents",
    "autonomous-agents",
    "agent-orchestration",
    "control-plane",
    "cli",
    "task-queue",
    "llm",
    "openrouter",
    "telegram",
    "unattended"
  ],
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/ap9000/toolroll/issues"
  },
  "homepage": "https://toolroll.dev",
  "bin": {
    "toolroll": "dist/bin.js",
    "standing-orders": "dist/bin.js"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@radix-ui/react-collapsible": "1.1.20",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-radio-group": "1.4.7",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-separator": "1.1.15",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-switch": "1.3.7",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-tooltip": "1.2.16",
    "@tailwindcss/cli": "4.3.3",
    "@types/mailparser": "3.9.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "@xyflow/react": "12.12.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "esbuild": "0.28.2",
    "happy-dom": "20.14.5",
    "ink": "6.8.0",
    "ink-testing-library": "4.0.0",
    "lucide-react": "1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "use-stick-to-bottom": "1.1.6",
    "vitest": "4.1.11"
  },
  "files": [
    "dist",
    "evals",
    "CHANGELOG.md",
    "scripts/provider-canary.mjs",
    "scripts/canary-assertions.mjs",
    "scripts/recovery-canary.mjs",
    "scripts/crash-canary.mjs",
    "scripts/fixtures/crash-process.mjs",
    "scripts/pilot.mjs",
    "scripts/fixtures/pilot-scenarios.mjs",
    "scripts/proof-preflight.mjs",
    "scripts/restart-certification.mjs",
    "scripts/launchd-certification.mjs",
    "scripts/fixtures/restart-service.mjs",
    "THIRD_PARTY_NOTICES.md"
  ],
  "overrides": {
    "@tailwindcss/cli@4.3.3": {
      "@parcel/watcher": "2.6.0"
    },
    "@slack/socket-mode": {
      "undici": "7.30.1"
    }
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.79",
    "@json-render/core": "0.22.0",
    "@slack/socket-mode": "3.1.1",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/headless": "6.0.0",
    "discord.js": "14.28.1",
    "imapflow": "2.10.0",
    "mailparser": "3.14.1",
    "nodemailer": "10.3.1",
    "typescript-parser": "npm:typescript@6.0.3",
    "undici": "7.30.1",
    "ws": "8.22.1",
    "yaml": "2.9.1",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "@lydell/node-pty": "1.2.0-beta.15"
  }
}
