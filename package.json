{
  "name": "toolroll",
  "version": "0.9.55",
  "description": "A control plane for unattended coding agents — queue tasks, walk away, come back to pull requests. Agents build in leased worktrees, never touch your default branch, and interrupt you only for decisions that need a human.",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/browser-build.mjs && node scripts/postbuild.mjs",
    "test": "vitest run",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.browser.json",
    "certify:provider": "npm run build && node scripts/provider-canary.mjs",
    "certify:recovery": "npm run build && node scripts/recovery-canary.mjs",
    "certify:crash": "npm run build && node scripts/crash-canary.mjs",
    "certify:pilot": "npm run build && node scripts/pilot.mjs",
    "prepublishOnly": "npm run typecheck && npm run build",
    "nul-scan": "node scripts/nul-scan.mjs",
    "proof-preflight": "node scripts/proof-preflight.mjs",
    "fixture:v47": "node scripts/derive-v47-fixture.mjs",
    "build:desktop": "node scripts/build-desktop.mjs",
    "certify:restart": "npm run build && node scripts/restart-certification.mjs",
    "certify:launchd": "npm run build && node scripts/launchd-certification.mjs",
    "test:native-containment": "vitest run src/containment-native.test.ts src/containment.test.ts",
    "build:browser": "node scripts/browser-build.mjs",
    "e2e:flows": "npm run build && node scripts/flows-e2e.mjs",
    "e2e:app": "npm run build && node scripts/app-e2e.mjs",
    "e2e:app:parallel": "npm run build && node scripts/e2e-parallel.mjs scripts/app-e2e.mjs",
    "e2e": "npm run build && node scripts/flows-e2e.mjs && node scripts/app-e2e.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ap9000/toolroll.git"
  },
  "keywords": [
    "agents",
    "orchestration",
    "claude-code",
    "codex",
    "git-worktree",
    "ai-agents",
    "autonomous-agents",
    "agent-orchestration",
    "control-plane",
    "cli",
    "task-queue",
    "llm",
    "openrouter",
    "telegram",
    "unattended"
  ],
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/ap9000/toolroll/issues"
  },
  "homepage": "https://github.com/ap9000/toolroll#readme",
  "bin": {
    "toolroll": "dist/bin.js",
    "standing-orders": "dist/bin.js"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "@types/mailparser": "3.9.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "happy-dom": "20.14.5",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "scripts/provider-canary.mjs",
    "scripts/canary-assertions.mjs",
    "scripts/recovery-canary.mjs",
    "scripts/crash-canary.mjs",
    "scripts/fixtures/crash-process.mjs",
    "scripts/pilot.mjs",
    "scripts/fixtures/pilot-scenarios.mjs",
    "scripts/proof-preflight.mjs",
    "scripts/restart-certification.mjs",
    "scripts/launchd-certification.mjs",
    "scripts/fixtures/restart-service.mjs",
    "THIRD_PARTY_NOTICES.md"
  ],
  "overrides": {
    "@tailwindcss/cli@4.3.3": {
      "@parcel/watcher": "2.6.0"
    }
  },
  "dependencies": {
    "@radix-ui/react-collapsible": "1.1.20",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-radio-group": "1.4.7",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-separator": "1.1.15",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-switch": "1.3.7",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-tooltip": "1.2.16",
    "@slack/socket-mode": "3.1.0",
    "@xyflow/react": "12.12.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "discord.js": "14.27.0",
    "imapflow": "2.2.5",
    "lucide-react": "1.52.0",
    "mailparser": "3.9.36",
    "nodemailer": "10.0.15",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "typescript-parser": "npm:typescript@6.0.3",
    "use-stick-to-bottom": "1.1.6",
    "yaml": "2.9.1",
    "zod": "^4.6.5"
  }
}
