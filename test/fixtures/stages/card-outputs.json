{
 "about": "Saved card outputs (flow_card.outputs_json, unversioned before 0.9.37) replayed by src/contracts/stage-output.test.ts. `reads` is what the 0.9.36 store (readFlowCardRow) read from `raw`, recorded by running it on a scratch database. The installed database (~/.config/standing-orders/orders.db) was not readable from the build that wrote this file (macOS refused even read-only access), so no row here is copied from it; each sample names the writer whose shape it records, with made-up, public-safe words.",
 "samples": [
  {
   "name": "a new card",
   "source": "flow_card.outputs_json default",
   "raw": "{}",
   "reads": {}
  },
  {
   "name": "a build's result",
   "source": "flow-engine.ts workStage (task done)",
   "raw": "{\"build\":\"Result ready on task fix-total.\"}",
   "reads": {
    "build": "Result ready on task fix-total."
   }
  },
  {
   "name": "a build whose checks failed",
   "source": "flow-engine.ts workStage (checks failed)",
   "raw": "{\"build\":\"The checks failed on its result: npm test exited 1 (task fix-total)\"}",
   "reads": {
    "build": "The checks failed on its result: npm test exited 1 (task fix-total)"
   }
  },
  {
   "name": "research with its items and report",
   "source": "flow-engine.ts workStage (report done) + reportFillIns",
   "raw": "{\"research\":\"Three onboarding patterns stand out; the checklist fits us best.\",\"research.items\":\"1. Checklist onboarding\\n   Short steps with progress. Fits our setup page.\\n   https://example.com/patterns/checklist\\n2. Empty states\\n   Teach in place.\\n   https://example.com/patterns/empty\",\"research.report\":\"# Onboarding patterns\\n\\nSummary first.\\n\\n## Items\\n\\n- Checklist onboarding\\n- Empty states\"}",
   "reads": {
    "research": "Three onboarding patterns stand out; the checklist fits us best.",
    "research.items": "1. Checklist onboarding\n   Short steps with progress. Fits our setup page.\n   https://example.com/patterns/checklist\n2. Empty states\n   Teach in place.\n   https://example.com/patterns/empty",
    "research.report": "# Onboarding patterns\n\nSummary first.\n\n## Items\n\n- Checklist onboarding\n- Empty states"
   }
  },
  {
   "name": "research whose report is linked (an older, longer summary)",
   "source": "flow-engine.ts workStage (passOn summary)",
   "raw": "{\"research\":\"This is 3,000 characters, more than the 12,000 a step passes on, so it is kept whole on task research-1.\"}",
   "reads": {
    "research": "This is 3,000 characters, more than the 12,000 a step passes on, so it is kept whole on task research-1."
   }
  },
  {
   "name": "a script step's long output, kept whole on the discussion",
   "source": "flow-steps.ts settle (passOn)",
   "raw": "{\"check\":\"This is 15,000 characters, more than the 12,000 a step passes on, so it is kept whole on the card's discussion: /flows/1?card=2.\"}",
   "reads": {
    "check": "This is 15,000 characters, more than the 12,000 a step passes on, so it is kept whole on the card's discussion: /flows/1?card=2."
   }
  },
  {
   "name": "a draft and what was sent",
   "source": "flow-steps.ts draftCard + flow-send.ts sendStep",
   "raw": "{\"draft\":\"Hi Sam,\\n\\nThanks for the report. The fix ships Friday.\\n\\nBest,\\nThe team\",\"send\":\"Charged twice · Draft reply\\n\\nHi Sam, thanks for the report.\"}",
   "reads": {
    "draft": "Hi Sam,\n\nThanks for the report. The fix ships Friday.\n\nBest,\nThe team",
    "send": "Charged twice · Draft reply\n\nHi Sam, thanks for the report."
   }
  },
  {
   "name": "an email reply a wait took",
   "source": "flow-replies.ts",
   "raw": "{\"wait-reply\":\"From: Sam Example <sam@example.com>\\n\\nThanks, that fixed it.\"}",
   "reads": {
    "wait-reply": "From: Sam Example <sam@example.com>\n\nThanks, that fixed it."
   }
  },
  {
   "name": "a pull request's result",
   "source": "flow-pull-request.ts",
   "raw": "{\"pull-request\":\"Pull request: https://github.com/example/shop/pull/12 (checks passed)\"}",
   "reads": {
    "pull-request": "Pull request: https://github.com/example/shop/pull/12 (checks passed)"
   }
  },
  {
   "name": "a sort's words",
   "source": "flow-steps.ts sortCard (sortWords)",
   "raw": "{\"sort\":\"Invoice problem (94% sure).\"}",
   "reads": {
    "sort": "Invoice problem (94% sure)."
   }
  },
  {
   "name": "a zone called version",
   "source": "any writer: a zone's id can be 'version'",
   "raw": "{\"version\":\"Bumped to 1.2.3.\",\"build\":\"Result ready on task bump.\"}",
   "reads": {
    "version": "Bumped to 1.2.3.",
    "build": "Result ready on task bump."
   }
  },
  {
   "name": "a research zone's items before its summary",
   "source": "flow-engine.ts workStage (a revisit re-adds items)",
   "raw": "{\"research\":\"Summary.\",\"build\":\"Result ready on task t1.\",\"research.items\":\"1. One\\n   why\\n   https://example.com/1\"}",
   "reads": {
    "research": "Summary.",
    "build": "Result ready on task t1.",
    "research.items": "1. One\n   why\n   https://example.com/1"
   }
  },
  {
   "name": "a value over the limit, saved before the limit",
   "source": "older releases kept long output whole",
   "raw": "{\"check\":\"\"}",
   "reads": {
    "check": ""
   }
  },
  {
   "name": "keys no writer makes",
   "source": "hand-edited or damaged row",
   "raw": "{\"Some Zone\":\"kept as it is\",\"a.b.c\":\"also kept\"}",
   "reads": {
    "Some Zone": "kept as it is",
    "a.b.c": "also kept"
   }
  },
  {
   "name": "values that aren't words",
   "source": "damaged row",
   "raw": "{\"build\":\"kept\",\"count\":3,\"nested\":{\"a\":\"b\"},\"nothing\":null,\"yes\":true}",
   "reads": {
    "build": "kept"
   }
  },
  {
   "name": "an array",
   "source": "damaged row",
   "raw": "[\"first\",\"second\"]",
   "reads": {
    "0": "first",
    "1": "second"
   }
  },
  {
   "name": "a string",
   "source": "damaged row",
   "raw": "\"just words\"",
   "reads": {}
  },
  {
   "name": "null",
   "source": "damaged row",
   "raw": "null",
   "reads": {}
  },
  {
   "name": "not JSON",
   "source": "damaged row",
   "raw": "{not json",
   "reads": {}
  }
 ]
}
