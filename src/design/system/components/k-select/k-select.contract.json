{
  "schema": "youi.component/v1",
  "id": "youi:toolroll/component/k-select",
  "name": "KSelect",
  "version": "1.0.0",
  "status": "stable",
  "summary": "A native select in the field family with the kit chevron: filled 36px, sm 28px pill, chip a composer pill; 44px and 16px on a phone.",
  "source": {
    "file": "k-select.tsx",
    "export": "KSelect",
    "also": []
  },
  "platforms": [
    "web"
  ],
  "props": {
    "items": {
      "type": "string",
      "required": true,
      "description": "A structured value: see the component's TypeScript type."
    },
    "sm": {
      "type": "boolean",
      "default": false
    },
    "wide": {
      "type": "boolean",
      "default": false
    }
  },
  "tokens": {
    "surface": "youi:toolroll/token/color.field",
    "chip": "youi:toolroll/token/color.composer-control",
    "ring": "youi:toolroll/token/color.ring"
  },
  "a11y": {
    "role": "combobox",
    "minTouchTarget": 44,
    "notes": []
  },
  "rules": [
    "youi:toolroll/rule/color.no-raw-color",
    "youi:toolroll/rule/tokens.no-arbitrary-values",
    "youi:toolroll/rule/components.canonical-import",
    "youi:toolroll/rule/props.contract-values"
  ],
  "guidance": {
    "do": [],
    "dont": [
      "No native-arrow selects and no area variants."
    ]
  },
  "examples": [],
  "aliases": [],
  "owners": []
}
