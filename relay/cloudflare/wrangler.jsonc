{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "toolroll-companion-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  // The official relay's address (the QR's relayUrl is wss://relay.toolroll.dev/v1/connect). A self-hoster changes
  // this and RELAY_PUBLIC_HOST together. CHALLENGE_SECRET is a secret: `wrangler secret put CHALLENGE_SECRET`.
  "routes": [{ "pattern": "relay.toolroll.dev", "custom_domain": true }],
  "durable_objects": {
    "bindings": [
      {
        "name": "MACHINE_ROOM",
        "class_name": "MachineRoomDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MachineRoomDO"]
    }
  ],
  // Per client address, per minute (Workers Rate Limiting; period must be 10 or 60 seconds). The namespace ids are
  // this account's own counters; a self-hoster picks any unused integers.
  "ratelimits": [
    { "name": "RL_REGISTER", "namespace_id": "4199001", "simple": { "limit": 20, "period": 60 } },
    { "name": "RL_CONNECT", "namespace_id": "4199002", "simple": { "limit": 120, "period": 60 } }
  ],
  "vars": {
    "RELAY_PUBLIC_HOST": "relay.toolroll.dev",
    "APNS_TOPIC": "dev.toolroll.ios",
    "APNS_ENVIRONMENT": "production"
  }
}
